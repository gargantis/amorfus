{
  "name": "amorfus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "node scripts/dev-lan.mjs",
    "lint": "eslint .",
    "public-scan": "node scripts/public-scan.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/licenses.mjs && node scripts/audit-dist.mjs",
    "wgsl": "node scripts/wgsl-check.mjs",
    "e2e": "playwright test",
    "check": "npm run lint && npm run public-scan && npm run typecheck && npm run test && npm run build && npm run wgsl && npm run e2e",
    "check:release": "node scripts/check-release.mjs",
    "cid": "node scripts/cid.mjs",
    "probe:relays": "node scripts/probe-relays.mjs",
    "publish:ipfs": "node scripts/publish-ipfs.mjs",
    "deploy": "npm run check && npm run probe:relays && wrangler deploy",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@trystero-p2p/nostr": "0.25.4",
    "idb": "^8.0.3",
    "wgpu-matrix": "^3.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "@webgpu/types": "^0.1.64",
    "eslint": "^10.0.0",
    "fake-indexeddb": "^6.2.0",
    "fast-check": "^4.10.0",
    "ipfs-car": "3.1.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "webgpu": "0.6.1",
    "wrangler": "^4.137.0",
    "ws": "^8.22.0"
  }
}
